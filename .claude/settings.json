{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-policy.py",
            "timeout": 15,
            "statusMessage": "git-policy: checking the branch rules"
          }
        ]
      }
    ]
  }
}
